---
/**
 * All document <head> metadata: title, description, canonical, Open Graph,
 * Twitter card, robots directives and the sitemap reference.
 */
import { site } from '../data/site';
import { absolute, url } from '../lib/paths';

interface Props {
  /** Page-specific title. Rendered as "<title> — Tina Williamson" unless `exactTitle`. */
  title: string;
  description: string;
  /** Site-root-relative path of this page, e.g. '/about/'. Used for canonical + OG. */
  path: string;
  /** Use the title verbatim (homepage only). */
  exactTitle?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  /** ISO date, emitted for article-type pages. */
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  exactTitle = false,
  ogType = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const fullTitle = exactTitle ? title : `${title} — ${site.name}`;
const canonical = absolute(path, Astro.site);
const ogImageUrl = site.ogImageEnabled ? absolute(site.ogImage, Astro.site) : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex
  ? <meta name="robots" content="noindex, follow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<meta name="author" content={site.name} />
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={`${site.name} — ${site.role}`} />
<meta property="og:locale" content="en_US" />
{ogImageUrl && (
  <>
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
  </>
)}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter / X -->
<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{ogImageUrl && <meta name="twitter:image:alt" content={site.ogImageAlt} />}

<meta name="theme-color" content="#0a0d12" />
<meta name="color-scheme" content="dark" />

<link rel="sitemap" href={url('/sitemap-index.xml')} />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
