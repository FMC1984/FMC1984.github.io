---
/**
 * Gold filament band — the signature device, using Tina's own artwork.
 *
 * The artwork is stored as an ALPHA MASK (greyscale WebP, ~26 KB) rather than a
 * full-colour image (~152 KB for the same thing). The gold comes from
 * --c-gold, so the band always matches the palette rather than carrying a
 * baked-in colour that could drift from it.
 *
 * Decorative only: aria-hidden, non-interactive, and it degrades to nothing
 * rather than to a gold rectangle where mask-image is unsupported.
 */
import { url } from '../lib/paths';

const mask = url('/images/art/filament-wave-mask.webp');
const maskSm = url('/images/art/filament-wave-mask-sm.webp');
---

<div
  class="flowlines"
  aria-hidden="true"
  style={`--flow-mask: url('${mask}'); --flow-mask-sm: url('${maskSm}')`}
></div>
