---
/**
 * Decorative gold line-work, echoing Tina's LinkedIn banner: a bundle of
 * filaments converging on a bright node, then sweeping out across the frame.
 *
 * Drawn as inline SVG rather than shipped as an image, so it is resolution
 * independent, themeable, costs no network request, and adds roughly 4 KB to
 * the HTML instead of ~150 KB of JPEG. Purely decorative — aria-hidden, and
 * the page reads identically without it.
 */

const N = 26;                 // filaments
const NODE_X = 300;           // convergence point
const NODE_Y = 196;

const lines = Array.from({ length: N }, (_, i) => {
  const t = i / (N - 1) - 0.5;        // -0.5 … 0.5
  const d = [
    `M -40 ${(NODE_Y + t * 360).toFixed(1)}`,
    `C 110 ${(NODE_Y + t * 170).toFixed(1)}, 225 ${(NODE_Y + t * 30).toFixed(1)}, ${NODE_X} ${NODE_Y}`,
    `C ${NODE_X + 130} ${(NODE_Y - t * 62).toFixed(1)}, 570 ${(252 + t * 88).toFixed(1)}, 780 ${(288 + t * 112).toFixed(1)}`,
    `C 1000 ${(316 + t * 120).toFixed(1)}, 1190 ${(246 + t * 96).toFixed(1)}, 1440 ${(206 + t * 104).toFixed(1)}`,
  ].join(' ');
  // filaments nearer the centre of the bundle read brighter
  const centrality = 1 - Math.abs(t) * 1.7;
  const opacity = (0.30 + Math.max(0, centrality) * 0.70).toFixed(3);
  const width = (0.6 + Math.max(0, centrality) * 0.75).toFixed(2);
  return { d, opacity, width };
});
---

<svg
  class="flowlines"
  viewBox="0 0 1400 350"
  preserveAspectRatio="xMinYMax slice"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="fl-stroke" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%"   stop-color="var(--c-gold)"  stop-opacity="0" />
      <stop offset="14%"  stop-color="var(--c-flare)" stop-opacity="0.95" />
      <stop offset="26%"  stop-color="var(--c-gold)"  stop-opacity="0.80" />
      <stop offset="62%"  stop-color="var(--c-gold)"  stop-opacity="0.42" />
      <stop offset="100%" stop-color="var(--c-gold)"  stop-opacity="0.16" />
    </linearGradient>

    <radialGradient id="fl-flare" cx="50%" cy="50%" r="50%">
      <stop offset="0%"   stop-color="var(--c-flare)" stop-opacity="0.80" />
      <stop offset="42%"  stop-color="var(--c-gold)"  stop-opacity="0.26" />
      <stop offset="100%" stop-color="var(--c-gold)"  stop-opacity="0" />
    </radialGradient>
  </defs>

  <ellipse cx={300} cy={196} rx="290" ry="118" fill="url(#fl-flare)" />

  <g fill="none" stroke="url(#fl-stroke)" stroke-linecap="round">
    {lines.map((l) => (
      <path d={l.d} stroke-opacity={l.opacity} stroke-width={l.width} />
    ))}
  </g>
</svg>
