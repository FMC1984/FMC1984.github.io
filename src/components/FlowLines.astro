---
/**
 * Gold filament band — the signature device, echoing Tina's LinkedIn banner.
 *
 * Modelled as a RIBBON, not a fan. Radiating every filament from a single point
 * reads as a cone no matter how the curve is tuned. Here each filament follows
 * the same undulating baseline, offset by its position in the ribbon, and the
 * ribbon's width is SIGNED about a waist — so the bundle converges, inverts and
 * opens out again. The inversion is the twist; without it the band merely
 * pinches.
 *
 *   y(x) = baseline(x) + t · width(x),  width signed about the waist
 *
 * Brightness comes from the strokes, not from a glow behind them.
 *
 * Inline SVG rather than an image: resolution independent, themeable, no
 * network request. Decorative only — aria-hidden.
 */

const N = 36;                  // filaments
const VW = 1400;
const VH = 290;

const X0 = -80;                // start off-canvas
const X1 = 1480;
const STEP = 45;               // sampling pitch; coarser = smaller markup
const WAIST = 300;             // where the ribbon pinches

/**
 * The sheet's centreline. It has to have real SLOPE where the ribbon crosses
 * itself: a flat centreline makes the crossing horizontal and the whole band
 * reads as a symmetric bowtie. A sigmoid descending through the waist makes the
 * crossing diagonal, which is what reads as a twist.
 */
const baseline = (x: number) =>
  80 +
  112 / (1 + Math.exp(-(x - 340) / 200)) +   // descends steeply through the waist
  10 * Math.sin((x + 150) / 260);            // slight undulation on top

/**
 * SIGNED ribbon half-width — this is what produces the twist.
 *
 * It is negative left of the waist and positive right of it, passing through
 * zero at the waist itself. So every filament converges to the waist and then
 * emerges on the opposite side of the bundle: the filament running along the
 * top at the left runs along the bottom at the right. An unsigned width (the
 * obvious version) keeps the filaments in order and merely pinches them, which
 * looks like a flattened ribbon rather than a twist.
 */
const halfWidth = (x: number) => {
  const d = x - WAIST;
  /* tanh saturates: the bundle opens quickly either side of the waist, then
     holds a near-constant thickness. Linear growth gives straight-sided
     triangles meeting at a point — an hourglass, not a flowing sheet. */
  return d < 0
    ? -66 * Math.tanh(-d / 230)
    : 92 * Math.tanh(d / 380);
};

const xs: number[] = [];
for (let x = X0; x <= X1; x += STEP) xs.push(x);
if (xs[xs.length - 1] !== X1) xs.push(X1);

const lines = Array.from({ length: N }, (_, i) => {
  const t = i / (N - 1) - 0.5;         // -0.5 … 0.5
  const points = xs
    .map((x) => `${x},${(baseline(x) + t * 2 * halfWidth(x)).toFixed(1)}`)
    .join(' ');

  /* Keep this shallow: it multiplies with the stroke gradient, and a steep
     falloff on both makes the outer filaments vanish on the right. */
  const centrality = Math.max(0, 1 - Math.abs(t) * 0.9);
  const opacity = (0.42 + centrality * 0.44).toFixed(3);

  return { points, opacity };
});
---

<svg
  class="flowlines"
  viewBox={`0 0 ${VW} ${VH}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="fl-stroke" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%"   stop-color="var(--c-gold)" stop-opacity="0.12" />
      <stop offset="22%"  stop-color="var(--c-gold)" stop-opacity="0.95" />
      <stop offset="48%"  stop-color="var(--c-gold)" stop-opacity="0.78" />
      <stop offset="78%"  stop-color="var(--c-gold)" stop-opacity="0.62" />
      <stop offset="100%" stop-color="var(--c-gold)" stop-opacity="0.48" />
    </linearGradient>
  </defs>

  <g fill="none" stroke="url(#fl-stroke)" stroke-width="0.8" stroke-linejoin="round">
    {lines.map((l) => <polyline points={l.points} stroke-opacity={l.opacity} />)}
  </g>
</svg>
