---
/**
 * Section background motif — one of Tina's gold wave variants, filling its
 * section edge to edge, top to bottom.
 *
 * `mask-size: cover` scales the artwork to fill the box and crops whatever
 * overflows, so the wave always reaches all four edges regardless of the
 * section's proportions. `focus` chooses which part survives the crop.
 *
 * Like the hero band, the artwork is an ALPHA MASK and the gold is painted
 * from --c-gold, so every motif is the same colour by construction.
 *
 * Decorative only: aria-hidden, non-interactive, removed in the light palette.
 */
import { url } from '../lib/paths';

interface Props {
  /** Which variant, 2–5. */
  variant?: 2 | 3 | 4 | 5;
  /** Which part of the artwork to keep when cropping. */
  focus?: 'top' | 'center' | 'bottom';
  /** 0–1. Capped by contrast: above ~0.14 gold text over the wave fails AA. */
  opacity?: number;
  flip?: boolean;
}

const { variant = 2, focus = 'center', opacity = 0.14, flip = false } = Astro.props;

const src = url(`/images/art/wave-${variant}.webp`);
const focusPos = { top: 'center top', center: 'center center', bottom: 'center bottom' }[focus];
---

<div
  class="art art--wave"
  aria-hidden="true"
  style={`opacity:${opacity}; --wave-mask:url('${src}'); --wave-focus:${focusPos};${flip ? ' transform:scaleX(-1);' : ''}`}
></div>
