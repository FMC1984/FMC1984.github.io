---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import { site } from '../data/site';
import { url, absolute } from '../lib/paths';
import { breadcrumbSchema, ids } from '../lib/schema';

const path = '/contact/';

/** Visible label for a profile link: strips the scheme, www and trailing slash. */
const handle = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const origin = Astro.site ? Astro.site.origin.replace(/\/$/, '') : site.origin;

const schemas = [
  breadcrumbSchema([
    { name: 'Home', item: absolute('/', Astro.site) },
    { name: 'Contact' },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    url: absolute(path, Astro.site),
    name: `Contact ${site.name}`,
    isPartOf: { '@id': ids.website(origin) },
    about: { '@id': ids.person(origin) },
    mainEntity: { '@id': ids.person(origin) },
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Tina Williamson about SEO, GEO, AEO and AI search strategy work — by email, LinkedIn or GitHub."
  path={path}
  schemas={schemas}
>
  <div class="container">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />
  </div>

  <Hero
    eyebrow="Contact"
    compact={true}
    lead="Email is the most reliable way to reach me. Happy to talk about roles, or about the work itself."
  >
    <Fragment slot="title">Get in touch</Fragment>
  </Hero>

  <section class="section section--tight section--ruled">
    <div class="container">
      <div class="grid grid--2" style="align-items:start;gap:var(--sp-6);">
        <div>
          <h2 style="font-size:var(--step-2);">Direct</h2>
          <dl class="facts" style="max-width:34rem;">
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
            <div>
              <dt>LinkedIn</dt>
              <dd><a href={site.linkedin} rel="me noopener">{handle(site.linkedin)}</a></dd>
            </div>
            <div>
              <dt>GitHub</dt>
              <dd><a href={site.github} rel="me noopener">{handle(site.github)}</a></dd>
            </div>
            <div>
              <dt>Location</dt>
              <dd>{site.location}</dd>
            </div>
          </dl>

          <p class="btn-row">
            <a class="btn btn--primary" href={`mailto:${site.email}`}>Email me</a>
            <a class="btn btn--ghost" href={url('/resume/')}>View résumé</a>
          </p>
        </div>

        <div class="card">
          <h2 style="font-size:var(--step-1);">What I'm looking for</h2>
          <p>
            Senior individual-contributor or lead roles where search strategy and the
            technical work sit with the same person — rather than strategy in one team
            and implementation in another.
          </p>
          <ul style="padding-left:1.1rem;margin:0 0 var(--sp-3);">
            <li>Organic search and GEO/AEO strategy</li>
            <li>Technical SEO and structured data</li>
            <li>Digital analytics and performance reporting</li>
            <li>Nonprofit and mission-driven digital work</li>
          </ul>
          <p>
            Remote, or hybrid around Camarillo. If you're hiring for something adjacent to
            this, it's still worth asking — the case studies cover the range better than a
            list does.
          </p>
          <p class="text-muted" style="font-size:var(--step--1);margin-bottom:0;">
            There's no contact form here on purpose. This is a static site, and a form would
            mean routing your message through a third-party service — a direct email is
            simpler and more private.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
